# MedQube Backend Environment
# Copy this file to .env and fill the real values locally or in your host dashboard.

# Neon PostgreSQL
# Use the Neon pooled async-compatible URL. Plain postgresql:// URLs are normalized by the backend.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require
DATABASE_FALLBACK_URL=sqlite+aiosqlite:///./quantumx.db

# JWT / sessions
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_INACTIVITY_DAYS=7

# OTP security
OTP_EXPIRE_MINUTES=15
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Cookies
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Frontend
FRONTEND_URL=http://localhost:3000

# SMTP email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=replace-with-smtp-username
EMAIL_PASSWORD=replace-with-smtp-app-password
EMAIL_FROM=MedQube Platform <noreply@quantumx.ai>

